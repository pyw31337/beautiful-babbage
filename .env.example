# Naver Booking Checker Configuration Template
# Copy this file to '.env' and fill in your details.

# SMTP Configuration (For sending emails)
# Example for Naver: smtp.naver.com
# Example for Gmail: smtp.gmail.com
SMTP_SERVER=smtp.naver.com
SMTP_PORT=465
SMTP_USER=your_naver_id@naver.com
SMTP_PASSWORD=your_smtp_password_or_app_password

# Receiver Email Address
RECEIVER_EMAIL=pyw213@naver.com

# Booking Details (Defaulted to Ashley Queens Yeouido Hangang Park place ID)
BUSINESS_ID=32333182
TARGET_DATE=2026-08-15

# Monitor Settings
# Sleep duration between runs in seconds (e.g. 900 for 15 minutes)
CHECK_INTERVAL_SECONDS=900
